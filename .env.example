# ============================================================
# Konfigurasi stack observability.
# Salin file ini menjadi `.env` lalu sesuaikan:  cp .env.example .env
# File `.env` TIDAK di-commit (lihat .gitignore) karena berisi kredensial.
# ============================================================

# --- Project ---
COMPOSE_PROJECT_NAME=observability

# --- Grafana ---
GRAFANA_IMAGE=grafana/grafana:nightly-ubuntu-slim
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# --- Mimir (metrics) ---
MIMIR_IMAGE=grafana/mimir:latest
MIMIR_PORT=9009

# --- Loki (logs) ---
LOKI_IMAGE=grafana/loki:main-89ea0d4
LOKI_PORT=3100

# --- Tempo (tracing) ---
TEMPO_IMAGE=grafana/tempo:2.7.2
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

# --- Blackbox exporter (probe) ---
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.28.0
BLACKBOX_PORT=9115

# --- Alloy host (scraper blackbox -> Mimir) ---
ALLOY_IMAGE=grafana/alloy:v1.16.3
ALLOY_PORT=12345